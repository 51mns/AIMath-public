{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PendingClaimObservation",
  "type": "object",
  "required": [
    "schema_version",
    "observation_source",
    "repository",
    "reservation_kind",
    "pr_number",
    "task_id",
    "principal_id",
    "base_main_sha",
    "head_sha",
    "collision_keys",
    "pr_state",
    "draft",
    "change_class",
    "lock_operation",
    "village_policy",
    "verify_conclusion",
    "observed_at",
    "lock_expires_at"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "observation_source": {"const": "GITHUB_API"},
    "repository": {"const": "51mns/AIMath-public"},
    "reservation_kind": {"const": "PENDING_CLAIM"},
    "pr_number": {"type": "integer", "minimum": 1},
    "task_id": {"type": "string", "pattern": "^TASK-[A-Z0-9-]+$"},
    "principal_id": {"type": "string", "pattern": "^gh:[A-Za-z0-9_.-]+$"},
    "worker_id": {"type": "string", "pattern": "^w-[0-9a-f]{16,32}$"},
    "base_main_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "collision_keys": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "pr_state": {"const": "OPEN"},
    "draft": {"const": false},
    "change_class": {"const": "LOCK_ONLY"},
    "lock_operation": {"const": "ACQUIRE"},
    "village_policy": {"const": "PASS"},
    "verify_conclusion": {"const": "SUCCESS"},
    "observed_at": {"type": "string", "minLength": 1},
    "lock_expires_at": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
