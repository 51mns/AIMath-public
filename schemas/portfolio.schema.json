{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Portfolio",
  "type": "object",
  "required": [
    "schema_version",
    "portfolio_id",
    "global_admission",
    "global_active_lane_cap",
    "source_snapshot",
    "governance",
    "allocation_policy"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "portfolio_id": {
      "type": "string",
      "minLength": 1
    },
    "global_admission": {
      "enum": [
        "OPEN",
        "PAUSED"
      ]
    },
    "global_active_lane_cap": {
      "type": "integer",
      "minimum": 1
    },
    "priorities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_snapshot": {
      "type": "object"
    },
    "governance": {
      "type": "object"
    },
    "allocation_policy": {
      "type": "object",
      "required": [
        "mode",
        "class_weights",
        "soft_class_caps_pct",
        "evaluation_bonus_cap",
        "rule"
      ],
      "properties": {
        "mode": {
          "const": "ADAPTIVE_DIVERSITY"
        },
        "class_weights": {
          "type": "object"
        },
        "soft_class_caps_pct": {
          "type": "object"
        },
        "evaluation_bonus_cap": {
          "type": "integer",
          "minimum": 0
        },
        "rule": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
